# Custodio: variables de entorno.
# Copia este archivo a .env (docker compose lo lee solo). Todas son opcionales: sin ninguna, Custodio arranca con
# la empresa demo, el riel simulado y sin modelo. Nunca subas tu .env al repositorio.

# Clave de Anthropic para Claude. Opcional. Sin ella siguen funcionando el motor de 12 reglas, el auditor
# independiente, el registro encadenado, el firewall por API y MCP, y la lectura de texto y de PDF con texto
# (por etiquetas «Campo: valor»). Lo que necesita al modelo (imágenes y PDF escaneados, reglas en español, perfil de
# empresa, importar proveedores, red team) responde «requiere ANTHROPIC_API_KEY» sin decidir nada.
ANTHROPIC_API_KEY=

# Base de datos Postgres (en Neon, la cadena postgresql:// que te da). En docker compose no hace falta: el servicio
# api apunta al postgres del compose. Sin ninguna, en desarrollo local se usa un archivo SQLite (custodio-dev.db).
DATABASE_URL=

# Contraseña del Postgres que levanta docker compose (sólo para el compose). Cámbiala si expones el puerto.
POSTGRES_PASSWORD=custodio

# Riel que ejecuta los pagos ya aprobados por el motor y confirmados por el auditor. Por defecto simulated (no mueve
# dinero ni usa la red). stripe_test paga por Stripe en modo de prueba. blinka_simulated arma la instrucción exacta para
# Blinka y no la envía. En producción, el riel de tu empresa (por ejemplo, Blinka). Un riel nunca decide: sólo ejecuta lo que las reglas ya aprobaron. Detalle en docs/PAYMENTS.md.
CUSTODIO_PAYMENT_RAIL=simulated

# Clave secreta de Stripe para el riel stripe_test. Sólo claves de prueba: deben empezar por sk_test_. Con una clave
# real (sk_live_ o rk_live_), vacía o de otro tipo, Custodio no la usa y paga con el riel simulated (lo avisa en el log
# sin mostrar la clave). Déjala vacía con el riel simulated.
STRIPE_SECRET_KEY=

# Clave Ed25519 con la que Custodio firma el recibo de cada decisión (un PEM PKCS#8 o la semilla de 32 bytes en base64
# o hex). Sin ella se deriva con HKDF de DATABASE_URL, así que es la misma en cada arranque; defínela si vas a rotar la
# contraseña de la base de datos o quieres guardarla aparte. La clave pública queda en /api/v1/.well-known/custodio-receipt-key.
CUSTODIO_RECEIPT_SIGNING_KEY=

# Tope de gasto en el modelo por día UTC, en dólares, para todo el despliegue. Al llegar al tope, lo que usa el
# modelo responde que no está disponible; las reglas siguen decidiendo. Por defecto 25.
CUSTODIO_LLM_DAILY_BUDGET_USD=25

# URL pública de la web, sin barra final. Se usa para armar el enlace al acta (acta_url) que devuelve el firewall.
# En docker compose, por defecto http://localhost:3000.
CUSTODIO_PUBLIC_BASE_URL=http://localhost:3000

# Dónde reenvía la web las llamadas a /api/v1 (sólo fuera de Vercel). En docker compose ya vale http://api:8000; en
# desarrollo local, http://127.0.0.1:8000. Next.js lo fija al construir la web.
API_INTERNAL_URL=
